---
import "../assets/global.css";
import Navigation from "../components/layout/nav/Navigation.vue";
import { type SearchEngineMetaData } from "../models/Head";
import Footer from "../components/layout/Footer.vue";
import DefaultSocialImage from "../assets/images/other/ProfilePhoto.jpg";

type Props = SearchEngineMetaData; 

const props = Astro.props;
const siteURL = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const pageTitle = `${props.title} | Adam Govier`;
const author = props.author ?? "Adam Govier";
const socialImageURL = new URL(props.image ?? DefaultSocialImage.src, siteURL);
const socialImageAlt = props.imageAlt ?? "Portrait of Adam Govier";
const pageType = props.type ?? "website";

const personId = new URL("/#person", siteURL).toString();
const websiteId = new URL("/#website", siteURL).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: "Adam Govier",
      jobTitle: "Software Developer",
      url: siteURL.toString(),
      sameAs: [
        "https://www.linkedin.com/in/adam-govier/",
        "https://github.com/AdamGovier",
      ],
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: "Adam Govier",
      url: siteURL.toString(),
      author: { "@id": personId },
    },
    pageType === "article"
      ? {
          "@type": "BlogPosting",
          headline: props.title,
          description: props.description,
          url: canonicalURL.toString(),
          mainEntityOfPage: canonicalURL.toString(),
          image: socialImageURL.toString(),
          datePublished: props.publishedTime
            ? new Date(props.publishedTime).toISOString()
            : undefined,
          author: { "@id": personId },
          publisher: { "@id": personId },
        }
      : {
          "@type": "WebPage",
          name: pageTitle,
          description: props.description,
          url: canonicalURL.toString(),
          isPartOf: { "@id": websiteId },
          author: { "@id": personId },
        },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={props.description} />
    <meta name="author" content={author} />
    {props.keywords?.length && <meta name="keywords" content={props.keywords.join(", ")} />}
    <meta
      name="robots"
      content={props.noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"}
    />

    <link rel="canonical" href={canonicalURL} />
    <script src="https://kit.fontawesome.com/1bf5d037b0.js" crossorigin="anonymous"></script>
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content="Adam Govier" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={props.description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {pageType === "article" && props.publishedTime && (
      <meta property="article:published_time" content={new Date(props.publishedTime).toISOString()} />
    )}
    {pageType === "article" && props.keywords?.map((keyword) => (
      <meta property="article:tag" content={keyword} />
    ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={props.description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script>
      import '../scripts/AstroHelpers.ts';
    </script>
  </head>

  <body>
    <div id="app">
      <Navigation client:idle />
      <!-- <div class="flex justify-end pt-4">
        <ToggleThemeButton client:idle />
      </div> -->

      <div id="page-container">
        <slot />
      </div>
    </div>

    <Footer />
  </body>
</html>
