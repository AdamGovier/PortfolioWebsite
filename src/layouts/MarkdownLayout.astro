---
import { type SearchEngineMetaData } from "../models/Head";
import BaseLayout from "./BaseLayout.astro";
import ToggleThemeButton from "../components/vue/inputs/ToggleThemeButton.vue";
import BlogCard from "../components/vue/blog/BlogCard.vue";
import { getCollection } from "astro:content";
import Attachments from "../components/vue/shared/Attachments.vue";
import Sources from "../components/vue/shared/Sources.vue";

const { title, description, author, date, image, slug, tags, attachments, sources } = Astro.props;

const dateParsed = new Date(date).toLocaleDateString('en-GB', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

const relatedPosts = (await getCollection('blog', item =>
  !item.data.draft &&
  item.data.slug != slug &&
  item.data.tags.some(tag => tags.includes(tag))
))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);

const url = `https://adamgovier.co.uk/${new Date(date).getFullYear()}/${slug}`;

const linkedInLink = `https://www.linkedin.com/shareArticle?mini=true&url=${encodeURI(url)}`
const facebookLink = `https://www.facebook.com/sharer/sharer.php?u=${encodeURI(url)}`
const xSocialLink = `https://x.com/intent/tweet?text=${encodeURI(url)}`
---

<BaseLayout
  title={title}
  description={description}
  author={author}
  image={image.url}
  imageAlt={image.alt}
  type="article"
  publishedTime={date}
  keywords={tags}
>
  <div>
    <div>
      <div />
      <div>
        <div>
          {tags && tags.map((tag: string) => (
            <div>
              <span>#{tag}</span>
            </div>
          ))}
        </div>
        <h1>{title}</h1>
        <p>{author ?? "Adam Govier"} | {dateParsed}</p>
        <a href="/blog">
          <i></i> Back to blog
        </a>
        <div></div>
        <div></div>
        <slot />

        <div>
          <strong>Share Post: </strong>

          <a href={linkedInLink}><i></i></a>
          <a href={facebookLink} target="_blank"><i></i></a>
          <a href={xSocialLink}><i></i></a>
        </div>

        {
          attachments &&
          <div>
            <Attachments attachments={attachments} />
          </div>
        }

        {
          sources &&
          <div>
            <Sources sources={sources} />
          </div>
        }
      </div>
    </div>

    <div>
      <div>
        <a href="/blog">
          <i></i> Back to blog
        </a>
      </div>

      <div>
        <strong>Share on: </strong>

        <a href={linkedInLink}><i></i></a>
        <a href={facebookLink} target="_blank"><i></i></a>
        <a href={xSocialLink}><i></i></a>
      </div>

      <Attachments attachments={attachments} />
      <Sources sources={sources} />

      {relatedPosts.length != 0 && (
        <div>
          <span>Related Posts</span>
        </div>
      )}

      {
        relatedPosts.map((card) => (
          <div>
            <BlogCard
              title={card?.data.title} 
              tags={card?.data.tags} 
              date={card?.data.pubDate} 
              author={card?.data.author} 
              imageURL={card?.data.image.url} 
              slug={card?.data.slug}
            />
          </div>
        ))
      }

    </div>
  </div>
</BaseLayout>
