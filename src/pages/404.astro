---
import ErrorPage from "../components/layout/ErrorPage.vue";
import BaseLayout from "../layouts/BaseLayout.astro";
import SleepyDogImage from "../assets/images/errors/sleepy_dog.webp";
---

<BaseLayout
  title="Page Not Found"
  description="The requested page could not be found on Adam Govier's website."
  noindex={true}
>
  <ErrorPage 
    code={404} 
    message="It looks like you may be lost! This page does not exist." 
    image={SleepyDogImage} 
    imageCaption="Surf Hostel Taghazout's dog Sam having a sleep!"
    />
</BaseLayout>
