{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "slug": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "alt"
      ]
    },
    "author": {
      "default": "Adam Govier",
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relativePath": {
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "pinned": {
      "type": "number",
      "minimum": 1,
      "maximum": 3
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "href": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "href",
          "contentType",
          "displayName"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "pubDate",
    "slug"
  ]
}